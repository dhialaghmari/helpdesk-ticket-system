# Copy to .env (never commit .env). Spring Boot reads these as environment variables;
# docker compose reads .env automatically.
DB_USERNAME=helpdesk
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# At least 12 chars with upper, lower, digit and symbol
ADMIN_PASSWORD=ChangeThisToAStrongPassword!
